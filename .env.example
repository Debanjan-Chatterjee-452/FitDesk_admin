# Copy this file to .env.local and fill in your own Supabase project.
#
# Use the *publishable* / anon key only. Never put a service-role or secret key
# in a VITE_* variable: everything prefixed with VITE_ is shipped to the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
